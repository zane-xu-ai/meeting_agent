# 阿里云百炼 API Key，ASR 必填，LLM 默认复用。
DASHSCOPE_API_KEY=

# 模型列表使用 JSON 数组，按顺序尝试。
# ASR_MODELS=["paraformer-v2"]
# LLM_MODELS=["qwen3.7-flash-2026-07-15"]
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=

ENABLE_VECTOR_STORE=false
DAILY_TASK_LIMIT=5
QUOTA_WHITELIST_IPS=[]

# 按需启用 LangSmith。
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=meeting_agent

# 工作区外部代理部署时使用 meeting 用户名和此令牌，建议由 TLS 反代保护。
# WORKSPACE_TOKEN=
# MAX_UPLOAD_BYTES=536870912

# PostgreSQL，先使用迁移账号运行 Alembic，再配置应用账号。
# DATABASE_URL=postgresql+psycopg://meeting_agent_app:password@127.0.0.1:5432/meeting_agent
# MEDIA_STORAGE_DIR=var/media

# RabbitMQ vhost. 启用后从数据库派发任务，由各 worker 消费。
# AMQP_URL=amqp://meeting_agent_publisher:password@127.0.0.1:5672/%2Fmeeting-agent
# AMQP_WORKER_URL=amqp://meeting_agent_worker:password@127.0.0.1:5672/%2Fmeeting-agent

# 单卡调度使用独立 gpu_ops 数据库，未配置时仍可使用云端 ASR。
# GPU_DATABASE_URL=postgresql+psycopg://meeting_gpu:password@127.0.0.1:5432/gpu_ops
# GPU_DEVICE_UUID=GPU-...
# LOCAL_ASR_PYTHON=/home/zane/projects/ai-labs/asr/.venv/bin/python
# LOCAL_ASR_MODEL=/home/zane/models/asr/faster-whisper-small

# 历史问答先启用精确事实查询；语义 API 和受约束统计按评测后开启。
KNOWLEDGE_ENABLED=true
KNOWLEDGE_SEMANTIC_ENABLED=false
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_AGGREGATE_ENABLED=false
