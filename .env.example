# 阿里云百炼 API Key，ASR 必填，LLM 默认复用。
DASHSCOPE_API_KEY=

# 模型列表使用 JSON 数组，按顺序尝试。
# ASR_MODELS=["paraformer-v2"]
# LLM_MODELS=["qwen3.7-flash-2026-07-15"]
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=

ENABLE_VECTOR_STORE=false
DAILY_TASK_LIMIT=5
QUOTA_WHITELIST_IPS=[]

# 按需启用 LangSmith。
LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=meeting_agent

# 工作区外部代理部署时使用 meeting 用户名和此令牌，建议由 TLS 反代保护。
# WORKSPACE_TOKEN=
# MAX_UPLOAD_BYTES=536870912
